# API Configuration
API_URL=http://localhost:3000/api/v1
WS_URL=ws://localhost:3000

# Google Maps (get from Google Cloud Console)
GOOGLE_MAPS_API_KEY_IOS=your_ios_api_key_here
GOOGLE_MAPS_API_KEY_ANDROID=your_android_api_key_here

# Expo Configuration (get from expo.dev)
EAS_PROJECT_ID=your_project_id_here

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_SENTRY=false

# Location Settings
DEFAULT_LOCATION_RADIUS_METERS=5000
LOCATION_UPDATE_INTERVAL_MS=30000
BACKGROUND_LOCATION_INTERVAL_MS=300000
